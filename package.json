{
  "name": "yumyumstudy",
  "version": "1.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "lucide-react": "^1.61.0",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-native-web-vite": "^10.6.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "scripts": {
    "update:test": "APP_VARIANT=test EXPO_PUBLIC_APP_VARIANT=test npx eas-cli@latest update --channel test --environment preview --platform android",
    "update:production": "gh workflow run cloud-build.yml --ref master -f target=production",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:iphone": "node scripts/iphone-web.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:web": "expo export --platform web && node scripts/secure-web-export.mjs",
    "build:android": "expo run:android --variant release",
    "build:android:test:local": "bash scripts/build-local-test.sh",
    "build:android:test:fast": "bash scripts/build-local-test.sh --fast",
    "eas-build-on-success": "node scripts/save-local-build-env.cjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "private": true
}
