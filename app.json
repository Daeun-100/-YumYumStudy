{
  "expo": {
    "name": "yumyumstudy",
    "slug": "yumyumstudy",
    "scheme": "yumyumstudy",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/app/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 4,
      "package": "com.yumyumstudy.app",
      "adaptiveIcon": {
        "backgroundColor": "#028669",
        "foregroundImage": "./assets/app/android-icon-foreground.png",
        "backgroundImage": "./assets/app/android-icon-background.png",
        "monochromeImage": "./assets/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app/web-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#028669"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app/android-icon-monochrome.png",
          "color": "#108363",
          "defaultChannel": "friend-calls",
          "largeIcon": "./assets/app/logo-transparent.png"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "973ad697-739b-49cc-bd6f-fbef67a1059e"
      }
    },
    "owner": "daeun-100s-team"
  }
}
