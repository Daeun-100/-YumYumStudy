{
  "expo": {
    "name": "yumyumstudy",
    "slug": "yumyumstudy",
    "scheme": "yumyumstudy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "package": "com.yumyumstudy.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app/android-icon-foreground.png",
        "backgroundImage": "./assets/app/android-icon-background.png",
        "monochromeImage": "./assets/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app/web-favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "973ad697-739b-49cc-bd6f-fbef67a1059e"
      }
    },
    "owner": "daeun-100s-team"
  }
}
