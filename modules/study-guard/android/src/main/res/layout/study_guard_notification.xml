<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/study_guard_timer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:fontFamily="monospace"
        android:text="00:00:00"
        android:textColor="@color/study_guard_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp" />
    <TextView
        android:id="@+id/study_guard_pause"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="80dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/study_guard_pause"
        android:contentDescription="@string/study_guard_pause"
        android:textColor="@color/study_guard_action"
        android:textSize="13sp"
        android:singleLine="true" />
</LinearLayout>
